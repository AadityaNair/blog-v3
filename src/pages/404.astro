---
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>404 - World's Edge</title>
    <meta name="description" content="You have reached the world's edge, none but devils play past here" />
    
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
</head>
<body class="homepage-body min-h-screen bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100 relative h-screen overflow-hidden">
  <!-- Background Images -->
  <div class="absolute inset-0 -z-10">
    <div class="w-full h-full bg-cover bg-center block dark:hidden" style="background-image: url('/404-light.svg');"></div>
    <div class="w-full h-full bg-cover bg-center hidden dark:block" style="background-image: url('/404-dark.svg');"></div>
    <!-- Overlay for readability -->
    <div class="absolute inset-0 bg-white/60 dark:bg-black/70"></div>
  </div>

  <main class="relative z-10 flex flex-col items-center justify-center min-h-[100dvh] text-center px-6">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-medium tracking-tight text-gray-900 dark:text-white drop-shadow-2xl leading-tight">
        You have reached the world's edge, none but devils play past here
      </h1>
      <div class="mt-10">
        <a 
          href="/" 
          class="text-xl md:text-2xl font-semibold text-gray-900 dark:text-white underline decoration-2 underline-offset-8 hover:decoration-4 transition-all"
        >
          Return to Safety
        </a>
      </div>
    </div>
  </main>
</body>
</html>
