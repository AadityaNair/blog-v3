---
import { getCollection } from "astro:content";
import "../../styles/global.css";

const posts = (await getCollection("blogs")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>Blog - Aaditya Nair</title>
  </head>
  <body class="min-h-screen max-w-2xl mx-auto px-4 py-12">
    <a href="/" class="text-gray-500 hover:text-gray-700 text-sm">&larr; Home</a>
    <h1 class="text-4xl font-bold mt-4 mb-8">Blog</h1>
    <ul class="space-y-6">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="group block">
            <h2 class="text-xl font-semibold group-hover:underline">{post.data.title}</h2>
            <p class="text-gray-500 text-sm mt-1">{post.data.excerpt}</p>
            {post.data.tags.length > 0 && (
              <div class="flex gap-2 mt-2">
                {post.data.tags.map((tag) => (
                  <a href={`/blog/tag/${tag}`} class="text-xs bg-gray-100 text-gray-600 hover:bg-gray-200 px-2 py-0.5 rounded">{tag}</a>
                ))}
              </div>
            )}
            <time class="text-gray-400 text-xs mt-1 block">
              {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
            </time>
          </a>
        </li>
      ))}
    </ul>
  </body>
</html>
