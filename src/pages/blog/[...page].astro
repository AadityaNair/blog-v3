---
import { getCollection } from "astro:content";
import "../../styles/global.css";
import ThemeToggle from "../../components/ThemeToggle.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Pagination from "../../components/Pagination.astro";
import { POSTS_PER_PAGE } from "../../consts";

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection("blogs")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
  );
  return paginate(posts, { pageSize: POSTS_PER_PAGE });
}

const { page } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Blog - Aaditya Nair</title>
    <meta name="description" content="Blog posts by Aaditya Nair - rm -rf / but with more steps." />
    <script is:inline>
      if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col max-w-4xl mx-auto px-4 py-12 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors">
    <ThemeToggle />
    <SiteHeader />
    <h2 class="text-2xl font-bold mb-8"><code class="font-mono">rm -rf / </code> but with more steps</h2>
    <ul class="space-y-6 flex-1">
      {page.data.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="group block">
            <h2 class="text-xl font-semibold group-hover:underline">{post.data.title}</h2>
            <p class="text-gray-500 dark:text-gray-400 text-sm mt-1">{post.data.excerpt}</p>
            {post.data.tags.length > 0 && (
              <div class="flex gap-2 mt-2">
                {post.data.tags.map((tag) => (
                  <a href={`/blog/tag/${tag}`} class="text-xs bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 px-2 py-0.5 rounded">{tag}</a>
                ))}
              </div>
            )}
            <time class="text-gray-400 dark:text-gray-500 text-xs mt-1 block">
              {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
            </time>
          </a>
        </li>
      ))}
    </ul>
    <Pagination page={page} />
  </body>
</html>
