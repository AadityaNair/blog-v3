---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Pagination from "../../components/Pagination.astro";
import PostPreview from "../../components/PostPreview.astro";
import { POSTS_PER_PAGE } from "../../consts";
import { getSortedPosts } from "../../utils/posts";

export async function getStaticPaths({ paginate }) {
  const posts = await getSortedPosts();
  return paginate(posts, { pageSize: POSTS_PER_PAGE });
}

const { page } = Astro.props;
---

<BaseLayout
  title="The Blog of Nair"
  description="Blog posts by Aaditya Nair - rm -rf / but with more steps."
  class="flex flex-col max-w-4xl mx-auto px-4 py-12"
>
  <SiteHeader />
  <h2 class="text-2xl font-bold mb-8 text-center"><code class="font-mono">rm -rf / </code> but with more steps</h2>
  <ul class="space-y-6 flex-1">
    {page.data.map((post) => (
      <PostPreview post={post} />
    ))}
  </ul>
  <Pagination page={page} />
</BaseLayout>
