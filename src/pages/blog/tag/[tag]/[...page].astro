---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import Pagination from "../../../../components/Pagination.astro";
import PostPreview from "../../../../components/PostPreview.astro";
import { POSTS_PER_PAGE } from "../../../../consts";
import { getSortedPosts } from "../../../../utils/posts";

export async function getStaticPaths({ paginate }) {
  const posts = await getSortedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.flatMap((tag) => {
    const filtered = posts.filter((post) => post.data.tags.includes(tag));
    return paginate(filtered, {
      params: { tag },
      pageSize: POSTS_PER_PAGE,
    });
  });
}

const { page } = Astro.props;
const { tag } = Astro.params;
---

<BaseLayout
  title={`Tag: ${tag} - Aaditya Nair`}
  description={`Blog posts tagged "${tag}" by Aaditya Nair.`}
  class="flex flex-col max-w-4xl mx-auto px-4 py-12"
>
  <SiteHeader />
  <h1 class="text-4xl font-bold mt-4 mb-8">Posts tagged "{tag}"</h1>
  <ul class="space-y-6 flex-1">
    {page.data.map((post) => (
      <PostPreview post={post} showTags={false} />
    ))}
  </ul>
  <Pagination page={page} />
</BaseLayout>
