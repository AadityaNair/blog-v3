---
import "../styles/global.css";
import { Image } from "astro:assets";
import ThemeToggle from "../components/ThemeToggle.astro";
import { SOCIAL_LINKS } from "../consts";
import photo from "../assets/photo.webp";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Website of Nair</title>
		<meta name="description" content="Aaditya Nair - Software engineer who loves building things for the web." />
		<script is:inline>
			if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="homepage-body min-h-screen flex items-center justify-center bg-white text-gray-900 transition-colors dark:bg-gray-900 dark:text-gray-100">
		<ThemeToggle />
		<main class="flex flex-col items-center text-center px-6">
			<Image
				src={photo}
				alt="Aaditya Nair"
				class="w-48 h-48 md:w-56 md:h-56 rounded-full object-cover mb-8"
				width={224}
				height={224}
				widths={[192, 224, 384, 448]}
				sizes="(min-width: 768px) 14rem, 12rem"
				fetchpriority="high"
				loading="eager"
			/>
			<h1 class="max-w-none whitespace-nowrap text-xl sm:text-3xl md:text-7xl font-semibold tracking-tight leading-[0.95]">I'm <span class="homepage-name">Aaditya M Nair</span>, a Software Engineer.</h1>
			<p class="max-w-3xl text-lg sm:text-xl md:text-3xl text-gray-500 dark:text-gray-400 mt-4 leading-snug">
				I love exploring how large systems work.
			</p>
			<div class="flex gap-6 mt-8 text-lg md:text-xl">
				<a href="/blog" class="text-blue-600 dark:text-blue-400 hover:underline">Blog</a>
				<a href="/about" class="text-blue-600 dark:text-blue-400 hover:underline">About</a>
			</div>
			<div class="flex gap-6 mt-5">
				<a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer" class="text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors" aria-label="LinkedIn">
					<svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
				</a>
				<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class="text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors" aria-label="GitHub">
					<svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
				</a>
				<a href={SOCIAL_LINKS.email} class="text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors" aria-label="Email">
					<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 4l-10 8L2 4"/></svg>
				</a>
				<a href={SOCIAL_LINKS.resume} target="_blank" rel="noopener noreferrer" class="text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors" aria-label="Resume">
					<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
				</a>
			</div>
		</main>
	</body>
</html>
