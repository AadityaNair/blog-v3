---
const pathname = Astro.url.pathname;
const isBlogActive = pathname.startsWith("/blog");
const isAboutActive = pathname.startsWith("/about");

const baseLinkClass = "text-blue-600 dark:text-blue-400 hover:underline";
const activeLinkClass = "font-semibold underline decoration-2 underline-offset-4";
---

<div class="flex flex-col items-center text-center mb-10 px-4">
	<h1 class="text-xl sm:text-3xl md:text-7xl font-semibold tracking-tight leading-[0.95]">
		<a href="/"><span class="homepage-name">Aaditya M Nair</span></a>
	</h1>
	<div class="flex gap-6 mt-5 text-lg md:text-xl">
		<a
			href="/blog"
			class:list={[baseLinkClass, isBlogActive && activeLinkClass]}
			aria-current={isBlogActive ? "page" : undefined}
		>
			Blog
		</a>
		<a
			href="/about"
			class:list={[baseLinkClass, isAboutActive && activeLinkClass]}
			aria-current={isAboutActive ? "page" : undefined}
		>
			About
		</a>
	</div>
</div>
